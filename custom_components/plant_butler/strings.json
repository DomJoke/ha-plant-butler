  "config_subentries": {
    "plant": {
      "entry_type": "Plant",
      "initiate_flow": {
        "user": "Add plant",
        "reconfigure": "Edit plant"
      },
      "step": {
        "user": {
          "title": "Plant",
          "description": "Choose the species to prefill all target values from the database, or \"Custom\" to enter them yourself.",
          "data": {
            "name": "Name",
            "species": "Species",
            "area_id": "Room"
          }
        },
        "sensors": {
          "title": "Sensors (all optional)",
          "description": "Without a soil sensor a schedule is used. Room temperature and humidity correct it for evaporation.",
          "data": {
            "moisture_sensor": "Soil moisture sensor",
            "illuminance_sensor": "Light sensor",
            "temperature_sensor": "Room temperature sensor",
            "humidity_sensor": "Room humidity sensor"
          }
        },
        "assistant": {
          "title": "Care assistant",
          "description": "Prefilled from the database. Tell the assistant about the pot and your fertilizer – it calculates watering amount, interval and fertilizer dose in the next step. Water need: very low = let the soil dry out completely, medium = water when the top few cm are dry, very high = keep constantly moist.",
          "data": {
            "water_need": "Water need",
            "light_need": "Light need",
            "location_light": "Light at the location (without light sensor)",
            "feeding": "Nutrient demand",
            "plant_size": "Plant size relative to the pot",
            "pot_diameter": "Pot diameter (top)",
            "pot_height": "Pot height",
            "pot_material": "Pot material",
            "substrate": "Substrate",
            "fertilizer_type": "Fertilizer",
            "fertilizer_dosage": "Fertilizer dose on the package"
          },
          "data_description": {
            "plant_size": "A plant with lots of foliage for its pot needs water more often (interval −20 %), a small one less often (+20 %).",
            "pot_diameter": "Leave empty if unknown – then no watering amount is calculated.",
            "pot_height": "Optional, default 0.9 × diameter.",
            "fertilizer_dosage": "Liquid fertilizer only: ml per litre of water as printed on the package."
          }
        },
        "profile": {
          "title": "Care plan",
          "description": "Assistant result: pot ≈ {volume} l → about {watering_amount} ml every {watering_interval} days; liquid fertilizer per watering ≈ {fertilizer_total} ml. Adjust anything you like – the room climate and winter rest also adjust the interval while running.",
          "data": {
            "watering_interval": "Watering interval",
            "temperature_min": "Minimum temperature",
            "temperature_max": "Maximum temperature",
            "watering_amount": "Watering amount",
            "fertilizer_interval": "Fertilizing interval (0 = never)",
            "fertilizer_winter_interval": "Fertilizing interval in winter rest (0 = pause)",
            "fertilizer_amount": "Fertilizer amount",
            "fertilizer_unit": "Fertilizer type / unit",
            "photo_upload": "Upload photo",
            "photo": "Photo URL or /local/ path",
            "notes": "Notes"
          }
        }
      },
      "error": {
        "unknown_species": "Unknown species – pick one from the list or \"Custom\"."
      },
      "abort": {
        "reconfigure_successful": "Plant updated."
      }
    }
  },
