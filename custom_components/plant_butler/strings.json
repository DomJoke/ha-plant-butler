  "options": {
    "step": {
      "init": {
        "title": "Plant Butler",
        "menu_options": {
          "general": "General",
          "phone": "Phone notifications",
          "announce": "Announcements (voice assistants & speakers)"
        }
      },
      "general": {
        "title": "General",
        "data": {
          "climate_strength": "Strength of the room climate correction"
        },
        "data_description": {
          "climate_strength": "Only for plants without a soil moisture sensor. Plant Butler uses room temperature and humidity to estimate how fast the soil dries out: warm, dry air shortens the watering interval, cool, humid air lengthens it (at most 0.6× to 1.4×). 0 = off (fixed interval), 1 = recommended, 2 = twice as strong – choose more if your plants are regularly dry before the reminder, less if they are still moist."
        }
      },
      "phone": {
        "title": "Phone notifications",
        "description": "Only Companion app phones are listed – they support buttons, urgent alerts and do-not-disturb detection. To hold messages during do-not-disturb, enable the 'Do Not Disturb' sensor in the Companion app (Settings → Companion app → Manage sensors).",
