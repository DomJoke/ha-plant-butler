              "critical": "Critical",
              "summary_time": "Time of the daily summary",
              "critical_repeat_hours": "Repeat critical every … hours (0 = never)",
              "critical_breaks_dnd": "Critical overrides do-not-disturb"
            },
            "data_description": {
              "critical_breaks_dnd": "Critical messages are sent as an alarm that sounds even in do-not-disturb mode."
            }
          },
          "quiet": {
            "name": "Quiet times",
            "data": {
              "quiet_start": "Quiet hours from",
              "quiet_end": "Quiet hours until",
              "respect_dnd": "Respect the phone's do-not-disturb"
