  "config": {
    "step": {
      "user": {
        "title": "Plant Butler",
        "description": "Plant Butler kümmert sich um deine Pflanzen. Nach der Einrichtung fügst du Pflanzen auf der Integrationsseite mit „+ Pflanze hinzufügen“ hinzu."
      }
    },
    "abort": {
      "single_instance_allowed": "Plant Butler ist bereits eingerichtet. Pflanzen fügst du auf der Integrationsseite hinzu."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Plant Butler",
        "menu_options": {
          "general": "Allgemein",
          "phone": "Handy-Benachrichtigungen",
          "announce": "Ansagen (Sprachassistenten & Lautsprecher)"
        }
      },
      "general": {
        "title": "Allgemein",
        "data": {
          "learning_strength": "Lernstärke",
          "learn_interval": "Gießintervall lernen",
          "learn_amount": "Gießmenge lernen",
          "climate_level": "Raumklima-Korrektur"
        },
        "data_description": {
          "learning_strength": "Wie schnell sich Plant Butler an deine Antworten anpasst. Gelernte Werte bleiben zwischen halbem und doppeltem berechnetem Intervall und zwischen 50 % und 150 % der berechneten Menge.",
          "learn_interval": "Nach dem Gießen fragt Plant Butler, wie die Erde war (noch feucht / leicht trocken / sehr trocken), und passt das Gießintervall jeder Pflanze an. Pflanzen mit Bodensensor lernen zusätzlich aus der gemessenen Austrocknungszeit.",
          "learn_amount": "Nach dem Gießen fragt Plant Butler, ob die Menge gepasst hat (zu viel / passt / zu wenig), und passt die Gießmenge jeder Pflanze an. Pflanzen mit Bodensensor lernen zusätzlich aus der gemessenen Feuchte. Ein Häkchen entfernen verwendet wieder die berechneten Werte – das Gelernte bleibt gespeichert und ist beim Einschalten sofort zurück. Zum vorübergehenden Pausieren (z. B. Urlaub) gibt es den Schalter „Dazulernen pausiert“.",
          "climate_level": "Nur für Pflanzen ohne Bodenfeuchtesensor. Plant Butler schätzt aus Raumtemperatur und Luftfeuchte, wie schnell die Erde austrocknet: Warme, trockene Luft verkürzt das Gießintervall, kühle, feuchte Luft verlängert es (höchstens 0,6- bis 1,4-fach). „Stark“ wählen, wenn deine Pflanzen vor der Erinnerung regelmäßig schon trocken sind, „Wenig“, wenn sie noch feucht sind, „Aus“ für ein festes Intervall."
        }
      },
